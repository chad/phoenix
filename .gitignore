node_modules/
dist/
.phoenix/
*.tsbuildinfo
.DS_Store
examples/*/data/

# Adversarial review scratch (throwaway repro scripts)
.adversarial/

# Bench workspace (disposable build state; results live in bench/results/)
.phoenix-bench/

# The library-api demo ships its .phoenix state so `why`, `journal --verify`,
# `ingest` and selective regen work from a fresh clone (see examples/library-api/README.md).
!examples/library-api/.phoenix/
!examples/library-api/.phoenix/**

# The bench page is DERIVED from bench/results/*.jsonl and published by CI.
# Two sources of truth for one set of numbers is how a results page starts lying.
bench/site/
